        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fixbolt_sessions_logged_on{engine=~\"$engine\"}",
          "refId": "A",
          "legendFormat": "{{engine}}"
        }
