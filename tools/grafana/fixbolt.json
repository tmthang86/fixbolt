        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fixbolt_connections{engine=~\"$engine\"}",
          "refId": "A",
          "legendFormat": "{{engine}}"
        }
