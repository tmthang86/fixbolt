{
  "id": null,
  "uid": "fixbolt",
  "title": "fixbolt",
  "description": "fixbolt-metrics: every series it exports, in five rows \u2014 health, loss (must be zero), pressure (ring + pre-session), per-session state, and why sessions end. Names no data source: the ${datasource} template variable is filled by the Grafana import dialog or by file provisioning (ADR-0171 decision 5). crates/metrics/tests/dashboard.rs checks every metric name a panel here queries against a real scrape.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "fixbolt",
    "fix",
    "prometheus"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source",
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "engine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(fixbolt_snapshot_available, engine)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(fixbolt_snapshot_available, engine)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "label": "Engine",
        "refresh": 2,
        "regex": "",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health \u2014 engine turning, session up",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Healthy",
      "description": "Snapshot::healthy(): at least one session, all logged on, no refusal, no missing source.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fixbolt_healthy{engine=~\"$engine\"}",
          "refId": "A",
          "legendFormat": "{{engine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Snapshot available",
      "description": "0 until the engine has published its first snapshot.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fixbolt_snapshot_available{engine=~\"$engine\"}",
          "refId": "A",
          "legendFormat": "{{engine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Snapshot age",
      "description": "Grows while a standard engine sleeps between asks; never woken by the exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fixbolt_snapshot_age_seconds{engine=~\"$engine\"}",
          "refId": "A",
          "legendFormat": "{{engine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Snapshots published (rate)",
      "description": "Flat at zero means the engine thread is not turning at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(fixbolt_snapshots_published_total{engine=~\"$engine\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{engine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Connections",
